{
  "version": 8,
  "sources": {
    "offline-tiles": {
      "type": "vector",
      "tiles": ["mbtiles://{z}/{x}/{y}"],
      "maxzoom": 14,
      "minzoom": 0,
      "scheme": "xyz",
      "volatile": true
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f0ebe0"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "offline-tiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#b3d9f2"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "offline-tiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#b3d9f2",
        "line-width": 1.5
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "offline-tiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential", "#e8e4db",
          "commercial", "#f2dede",
          "industrial", "#ebdbe8",
          "grass", "#d8e8c8",
          "park", "#c8e6c8",
          "forest", "#b8d8a8",
          "wood", "#b8d8a8",
          "cemetery", "#d8e0d0",
          "sand", "#f5e9c6",
          "#e8e4db"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "offline-tiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "grass", "#d8e8c8",
          "forest", "#b8d8a8",
          "wood", "#b8d8a8",
          "ice", "#e8f4f8",
          "sand", "#f5e9c6",
          "#e8e4db"
        ],
        "fill-opacity": 0.4
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "offline-tiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c8e6c8",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "offline-tiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#d9d0c9",
        "fill-outline-color": "#b8b0a8",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14, 0,
          15, 0.7
        ]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "offline-tiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": {
        "line-color": "#fc8",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          5, 0.8,
          10, 2,
          14, 5,
          18, 10
        ]
      }
    },
    {
      "id": "road-trunk-primary",
      "type": "line",
      "source": "offline-tiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["trunk", "primary"]]],
      "paint": {
        "line-color": "#fea",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          5, 0.6,
          10, 1.5,
          14, 4,
          18, 8
        ]
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "offline-tiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "paint": {
        "line-color": "#fff",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          10, 0.8,
          14, 2.5,
          18, 6
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "offline-tiles",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service"]]],
      "minzoom": 12,
      "paint": {
        "line-color": "#fff",
        "line-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          12, 0.5,
          14, 1.5,
          18, 4
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "offline-tiles",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "path"],
      "minzoom": 14,
      "paint": {
        "line-color": "#d4a574",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "offline-tiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#8b7a9a",
        "line-width": 2,
        "line-dasharray": [3, 3]
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "offline-tiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Bold"],
        "text-size": 14,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#333",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-town-village",
      "type": "symbol",
      "source": "offline-tiles",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["town", "village"]]],
      "minzoom": 10,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-size": 11,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#555",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "offline-tiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular"],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#666",
        "text-halo-color": "#fff",
        "text-halo-width": 1
      }
    }
  ],
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf"
}
