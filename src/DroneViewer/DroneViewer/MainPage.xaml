<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DroneViewer.MainPage">

    <Grid RowDefinitions="Auto,*">
        <!-- Status Bar -->
        <Frame Grid.Row="0" BackgroundColor="#2196F3" Padding="10" CornerRadius="0">
            <Label x:Name="StatusLabel" 
                   Text="⚡ Bereit" 
                   TextColor="White" 
                   FontSize="14"
                   HorizontalOptions="Center"/>
        </Frame>

        <!-- Map View -->
        <WebView x:Name="MapView" 
                 Grid.Row="1"/>

        <!-- Floating Action Buttons (Overlays) -->
        <VerticalStackLayout Grid.Row="1" 
                             Spacing="15" 
                             Padding="20"
                             VerticalOptions="End"
                             HorizontalOptions="End">

            <!-- Scannen Button -->
            <Border BackgroundColor="#80000000"
                    StrokeThickness="0"
                    WidthRequest="48"
                    HeightRequest="48">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScanClicked"/>
                </Border.GestureRecognizers>
                <Label Text="○ )"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Trennen Button -->
            <Border BackgroundColor="#80000000"
                    StrokeThickness="0"
                    WidthRequest="48"
                    HeightRequest="48">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDisconnectClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✕"
                       TextColor="White"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Standort Button -->
            <Border BackgroundColor="#80000000"
                    StrokeThickness="0"
                    WidthRequest="48"
                    HeightRequest="48">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLocationClicked"/>
                </Border.GestureRecognizers>
                <Label Text="◉"
                       TextColor="White"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Drohnen Liste Button -->
            <Border BackgroundColor="#80000000"
                    StrokeThickness="0"
                    WidthRequest="48"
                    HeightRequest="48">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDroneListClicked"/>
                </Border.GestureRecognizers>
                <Label Text="✈"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <!-- Settings Button -->
            <Border BackgroundColor="#80000000"
                    StrokeThickness="0"
                    WidthRequest="48"
                    HeightRequest="48">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsClicked"/>
                </Border.GestureRecognizers>
                <Label Text="⚙"
                       TextColor="White"
                       FontSize="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

        </VerticalStackLayout>

        <!-- Drohnen Liste Overlay (anfangs versteckt) -->
        <Frame Grid.Row="1"
               x:Name="DroneListOverlay"
               BackgroundColor="White"
               Padding="0"
               CornerRadius="12"
               IsVisible="False"
               WidthRequest="320"
               HeightRequest="400"
               HorizontalOptions="Center"
               VerticalOptions="Center">
            <Frame.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.4"/>
            </Frame.Shadow>

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" 
                      BackgroundColor="#2196F3" 
                      Padding="16,12"
                      ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Aktive Drohnen"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="✕"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="24"
                            Padding="8,0"
                            Clicked="OnCloseDroneListClicked"/>
                </Grid>

                <!-- Drohnen Liste -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="DroneListContainer" 
                                        Padding="12"
                                        Spacing="8"/>
                </ScrollView>

                <!-- Footer Info -->
                <Label Grid.Row="2"
                       x:Name="DroneCountLabel"
                       Text="0 Drohnen aktiv"
                       TextColor="#666"
                       FontSize="12"
                       Padding="16,8"
                       HorizontalOptions="Center"/>
            </Grid>
        </Frame>
    </Grid>

</ContentPage>
